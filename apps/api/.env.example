# Local development. Production values come from Secret Manager — see docs/DEPLOY.md.

# Local Postgres from `pnpm docker:up`.
# On Cloud Run this is the Cloud SQL unix socket form:
#   postgres://USER:PASSWORD@/gold_platform?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgres://postgres:password@localhost:5432/gold_platform

PORT=3000

# At least 32 characters. Generate, never invent:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-32-char-secret-key

# Comma-separated browser origins allowed to call this API. Required — there is no default, and
# the server will not start without it. In production this is the SPA's own origin.
CORS_ORIGIN=http://localhost:5173

# Optional — the hour (0-23) the nightly confirm sweep runs, per domain. Only used to display when
# a transaction stops being editable; set them to match the real cron. Default 0.
#
# A wall-clock hour in the shop: 0 means midnight in Asia/Bangkok, whatever timezone the server
# runs in. Do not set TZ to compensate — see docs/DEPLOY.md.
WHOLESALE_BUY_AUTO_CONFIRM_HOUR=0
WHOLESALE_SELL_AUTO_CONFIRM_HOUR=0

# Seeding only (`pnpm db:seed`). Neither password has a default and both must be at least 12
# characters. Re-running the seed never changes an account that already exists.
#
# The ADMIN — can adjust inventory, run the confirm sweeps, and create further logins.
# SEED_USERNAME=admin
# SEED_PASSWORD=

# Optional second login for trying the app as an ordinary operator: runs the trading day, but
# cannot adjust stock or confirm the book. Created only when the password is set, so a production
# seed does not quietly gain a shared account nobody is named on. Real staff logins are issued
# individually through POST /auth/users.
# SEED_OPERATOR_USERNAME=operator
# SEED_OPERATOR_PASSWORD=
